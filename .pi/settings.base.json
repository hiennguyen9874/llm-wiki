{
  "packages": [
    "npm:pi-commandcode-provider",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@xynogen/pix-footer",
    "-git:github.com/hiennguyen9874/pi-ask-user",
    "git:github.com/hiennguyen9874/pi-edit@feat/multi-edit-input",
    "-git:github.com/hiennguyen9874/pi-shake",
    "git:github.com/hiennguyen9874/pi-grep-glob",
    "npm:pi-observational-memory"
  ],
  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "-builtin:llama.cpp",
    "./extensions/command-history/index.ts",
    "-./extensions/confirm-destructive.ts",
    "-./extensions/dirty-repo-guard.ts",
    "./extensions/profile/index.ts",
    "./extensions/pi-documentation.ts",
    "-./extensions/disable-project-context.ts",
    "./extensions/skills-instructions-rewriter.ts",
    "./extensions/prompt-skills.ts",
    "./extensions/save-last-response.ts",
    "./extensions/dump-system-prompt.ts",
    "-./extensions/visual-explainer.ts",
    "-./extensions/disable-bash-tool.ts",
    "-./extensions/disable-edit-tools.ts",
    "-./extensions/disable-write-tool.ts",
    "-./extensions/enable-ls-tool.ts",
    "-./extensions/disable-read-tool.ts",
    "./extensions/system-prompt-appender.ts",
    "./extensions/remove-pi-env-guideline.ts",
    "./extensions/disable-om-recall-tool.ts"
  ],
  "extensionState": {
    "piDocumentationEnabled": false,
    "systemPromptAppenderEnabled": true,
    "systemPromptAppenderPromptPath": "system-prompt.md",
    "skillsInstructionsRewriterDisabledSkillFilters": [
      "context-mode",
      "ctx-doctor",
      "ctx-insight",
      "ctx-purge",
      "ctx-stats",
      "ctx-upgrade",
      "find-skills"
    ]
  },
  "enabledModels": [
    "openai-codex/*",
    "opencode-go/*",
    "opencode/*-free",
    "opencode/*-free*",
    "commandcode/*",
    "commandcode/*/*",
    "anthropic/*",
    "cliproxyapi/*"
  ],
  "showCacheMissNotices": true,
  "hideThinkingBlock": false,
  "piEdit": {
    "fuzzyMatch": true,
    "fuzzyThreshold": 0.95
  },
  "piCodexImageGen": {
    "mode": "minimal",
    "defaults": {
      "model": "gpt-image-2.5-flare",
      "quality": "auto",
      "size": "auto",
      "background": "auto"
    }
  },
  "warnings": {
    "anthropicExtraUsage": false
  }
}