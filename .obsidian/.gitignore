# Ignore Obsidian state and machine-specific files by default.
*

# This file contains the shared vault configuration allowlist.
!.gitignore
!app.json
!appearance.json
!community-plugins.json
!core-plugins.json

# Keep installed plugins and their configuration/versioned assets.
!plugins/
!plugins/**

# Keep installed themes selected by appearance.json.
!themes/
!themes/**

# Ignore workspace/view state explicitly.
workspace.json
graph.json
