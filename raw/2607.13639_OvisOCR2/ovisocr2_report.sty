\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ovisocr2_report}[2026/07/02 OvisOCR2 technical report template]

\RequirePackage[a4paper,margin=2.5cm,headheight=28pt]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\RequirePackage{url}

\definecolor{ovisgray}{HTML}{4D4D4D}
\definecolor{ovislinkblue}{RGB}{0,0,128}

\hypersetup{
  colorlinks=true,
  citecolor=ovislinkblue,
  linkcolor=ovislinkblue,
  urlcolor=ovislinkblue
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5pc}
\renewcommand{\topfraction}{0.95}
\renewcommand{\textfraction}{0.05}

\newcommand{\OvisHeaderLogos}{%
  \includegraphics[height=12pt]{logo/alibaba.png}%
  \hspace{0.2cm}%
  \rule{0.4pt}{0.4cm}%
  \hspace{0.2cm}%
  \includegraphics[height=14pt]{logo/ovis_logo.png}%
}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\OvisHeaderLogos}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{1pt}
\renewcommand{\headrule}{%
  \hbox to\headwidth{\color{ovisgray}\leaders\hrule height \headrulewidth\hfill}%
}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\OvisHeaderLogos}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{1pt}%
  \renewcommand{\headrule}{%
    \hbox to\headwidth{\color{ovisgray}\leaders\hrule height \headrulewidth\hfill}%
  }%
}
