dBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"Egt0MzdvemN2VHo0SSDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"154"},"label":{"simpleText":"Lượt xem"},"accessibilityText":"154 lượt xem","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294440951,"raisedBackground":4294440951,"additiveBackground":562530183,"textPrimary":4280295456,"textSecondary":4283716692,"invertedBackground":4283716692,"overlayBackground":3424657440},"darkThemeColorPalette":{"baseBackground":4279176975,"raisedBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"12 thg 6"},"label":{"simpleText":"2026"},"accessibilityText":"12 thg 6, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294440951,"raisedBackground":4294440951,"additiveBackground":562530183,"textPrimary":4280295456,"textSecondary":4283716692,"invertedBackground":4283716692,"overlayBackground":3424657440},"darkThemeColorPalette":{"baseBackground":4279176975,"raisedBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBIQ040EGAciEwjyt9SO0e-WAxWChsoCHUtuI47KAQR9b2Uo","commandMetadata":{"webCommandMetadata":{"url":"/@RedHatDevelopers","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC7noUdfWp-ukXUlAsJnSm-Q","canonicalBaseUrl":"/@RedHatDevelopers"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/A3R4flViyDbjXMRSic4vnIAub2S6HfFUYSJUKKxLbdv6PbrZnRFINGaSsuaxgTN4YPLpRYlebQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Hiện thêm"}},"simpleText":"...thêm"},"showLessText":{"simpleText":"Ẩn bớt"},"attributedDescriptionBodyText":{"content":"Ever wondered how LLM serving engines handle short-term memory without crushing your GPU? Below is a step-by-step visual breakdown of vLLM's PagedAttention mechanism.\n\nEvery time a large language model processes a prompt, it creates a key-value (KV) cache to speed up token generation. In traditional setups, this memory must be contiguous, leading to massive fragmentation and wasted VRAM.\n\nThis animation visualizes how PagedAttention solves this problem by managing KV cache memory exactly like an operating system manages virtual memory.\n\nVideo breakdown:\n0:00 - Before Generation: The logical blocks, block table, and physical KV cache blocks start entirely empty.\n\n0:03 - Prompt ingestion: The prompt \"Alan Turing is a computer scientist\" is processed. Space is allocated, filling Physical Block 7 and partially filling Physical Block 1.\n\n0:06 - 1st Token: The model generates \"and\", filling another slot in Physical Block 1.\n\n0:09 - 2nd Token: The model generates \"mathematician\", completely filling up Physical Block 1.\n\n0:12 - 3rd Token (New Block Allocation): As the model generates \"renowned\", PagedAttention dynamically allocates a brand-new physical block (Block 3) on demand to map the new token's KV cache data!\n\nBy mapping logical KV cache blocks to non-contiguous physical memory, vLLM dynamically allocates and frees blocks to maximize GPU utilization and scale throughput for multiple concurrent users.\n\nIf you're building RAG pipelines, deploying AI agents, or trying to scale open-weight models in production, understanding PagedAttention is the key to optimizing your infrastructure.","commandRuns":[{"startIndex":560,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAciEwjyt9SO0e-WAxWChsoCHUtuI47KAQR9b2Uo","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=t37ozcvTz4I","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"t37ozcvTz4I","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr6---sn-8qj-nbo66.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026msp=1\u0026odepv=1\u0026id=b77ee8cdcbd3cf82\u0026ip=113.172.232.83\u0026initcwndbps=1896250\u0026mt=1789441959\u0026oweuc="}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"0 giây"}}},{"startIndex":671,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAciEwjyt9SO0e-WAxWChsoCHUtuI47KAQR9b2Uo","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=t37ozcvTz4I\u0026t=3s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"t37ozcvTz4I","continuePlayback":true,"startTimeSeconds":3,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr6---sn-8qj-nbo66.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026msp=1\u0026odepv=1\u0026id=b77ee8cdcbd3cf82\u0026ip=113.172.232.83\u0026osts=3\u0026initcwndbps=1896250\u0026mt=1789441959\u0026oweuc="}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"3 giây"}}},{"startIndex":845,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAciEwjyt9SO0e-WAxWChsoCHUtuI47KAQR9b2Uo","commandMetadata":{"webCommandMetadata"