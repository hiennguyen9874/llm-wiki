ackingParams":"CNQBEM2rARgBIhMI8rfUjtHvlgMVgobKAh1LbiOO"}},"showMoreText":{"simpleText":"...thêm"},"showLessText":{"simpleText":"Ẩn bớt"},"trackingParams":"CNQBEM2rARgBIhMI8rfUjtHvlgMVgobKAh1LbiOO","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CNQBEM2rARgBIhMI8rfUjtHvlgMVgobKAh1LbiOOygEEfW9lKA==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CNQBEM2rARgBIhMI8rfUjtHvlgMVgobKAh1LbiOOygEEfW9lKA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CNQBEM2rARgBIhMI8rfUjtHvlgMVgobKAh1LbiOOygEEfW9lKA==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CNQBEM2rARgBIhMI8rfUjtHvlgMVgobKAh1LbiOOygEEfW9lKA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Ever wondered how LLM serving engines handle short-term memory without crushing your GPU? Below is a step-by-step visual breakdown of vLLM's PagedAttention mechanism.\n\nEvery time a large language model processes a prompt, it creates a key-value (KV) cache to speed up token generation. In traditional setups, this memory must be contiguous, leading to massive fragmentation and wasted VRAM.\n\nThis animation visualizes how PagedAttention solves this problem by managing KV cache memory exactly like an operating system manages virtual memory.\n\nVideo breakdown:\n0:00 - Before Generation: The logical blocks, block table, and physical KV cache blocks start entirely empty.\n\n0:03 - Prompt ingestion: The prompt \"Alan Turing is a computer scientist\" is processed. Space is allocated, filling Physical Block 7 and partially filling Physical Block 1.\n\n0:06 - 1st Token: The model generates \"and\", filling another slot in Physical Block 1.\n\n0:09 - 2nd Token: The model generates \"mathematician\", completely filling up Physical Block 1.\n\n0:12 - 3rd Token (New Block Allocation): As the model generates \"renowned\", PagedAttention dynamically allocates a brand-new physical block (Block 3) on demand to map the new token's KV cache data!\n\nBy mapping logical KV cache blocks to non-contiguous physical memory, vLLM dynamically allocates and frees blocks to maximize GPU utilization and scale throughput for multiple concurrent users.\n\nIf you're building RAG pipelines, deploying AI agents, or trying to scale open-weight models in production, understanding PagedAttention is the key to optimizing your infrastructure.","commandRuns":[{"startIndex":560,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CNQBEM2rARgBIhMI8rfUjtHvlgMVgobKAh1LbiOOygEEfW9lKA==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=t37ozcvTz4I","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"t37ozcvTz4I","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr6---sn-8qj-nbo66.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026msp=1\u0026odepv=1\u0026id=b77ee8cdcbd3cf82\u0026ip=113.172.232.83\u0026initcwndbps=1896250\u0026mt=1789441959\u0026oweuc="}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"0 giây"}}},{"startIndex":671,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CNQBEM2rARgBIhMI8rfUjtHvlgMVgobKAh1LbiOOygEEfW9lKA==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=t37ozcvTz4I\u0026t=3s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"t37ozcvTz4I","continuePlayback":true,"startTimeSeconds":3,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https