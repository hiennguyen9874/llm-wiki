% primeintellect_preprint.sty
% Prime Intellect preprint style, matching the INTELLECT-3 Technical Report
% (arxiv.sty / NeurIPS-derived look): centered logo, thick rule, title, thin rule,
% centered author block, centered Abstract, Times text + Computer Modern math.
% Options:  lineno -> line numbers;  nologo -> suppress the top logo.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{primeintellect/primeintellect_preprint}[2026/07/10 Prime Intellect preprint (arxiv-style)]

\newif\ifpi@lineno \pi@linenofalse
\DeclareOption{lineno}{\pi@linenotrue}
\newif\ifpi@logo \pi@logotrue
\DeclareOption{nologo}{\pi@logofalse}
\DeclareOption*{}
\ProcessOptions\relax

% ---- geometry (arxiv.sty defaults) ----------------------------------------
\RequirePackage[letterpaper,left=1.5in,right=1.5in,top=1.0in,bottom=1.0in,headheight=14pt,headsep=16pt,footskip=24pt]{geometry}
\RequirePackage{setspace}

% ---- color ----------------------------------------------------------------
\RequirePackage{xcolor}
\definecolor{primeaccent}{HTML}{E8590C}
\definecolor{primeink}{HTML}{111418}
\definecolor{primemuted}{HTML}{5B6470}

% ---- fonts: Times text + Computer Modern math (as in INTELLECT-3) ----------
\RequirePackage[T1]{fontenc}
\RequirePackage{mathptmx}      % Times text, keeps CM-like math metrics
\RequirePackage{inconsolata}
\RequirePackage{microtype}

% ---- graphics / tables / captions -----------------------------------------
\RequirePackage{graphicx}
\RequirePackage{caption}
\captionsetup{labelfont=bf,textfont=rm,labelsep=colon,font=small}

% ---- section headings (arxiv-style: bold serif, small-caps subsections) ----
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\Large\bfseries\color{primeink}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalfont\large\bfseries\color{primeink}}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\color{primeink}}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{1.6ex plus .3ex}{0.9ex}
\titlespacing*{\subsection}{0pt}{1.2ex plus .2ex}{0.6ex}
\renewcommand{\paragraph}[1]{\par\vspace{0.4ex}\noindent{\bfseries #1}\hspace{0.6em}\ignorespaces}

% ---- running header / footer ----------------------------------------------
\RequirePackage{fancyhdr}
\newcommand{\pi@runningtitle}{}
\newcommand{\runningtitle}[1]{\renewcommand{\pi@runningtitle}{#1}}
\newcommand{\pi@venue}{Prime Intellect}
\newcommand{\venuetag}[1]{\renewcommand{\pi@venue}{#1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\itshape\color{primemuted}\pi@runningtitle}
\fancyhead[R]{\footnotesize\scshape\color{primemuted}\pi@venue}
\fancyfoot[C]{\footnotesize\color{primemuted}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\color{primemuted}\thepage}\renewcommand{\headrulewidth}{0pt}}

% ---- title block (arxiv.sty style: logo, thick rule, title, thin rule) -----
\newcommand{\pi@logofile}{primeintellect/prime_intellect_logo.png}
\newcommand{\logofile}[1]{\renewcommand{\pi@logofile}{#1}}
\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \begin{center}
    \ifpi@logo
      \IfFileExists{primeintellect/prime_intellect_logo.png}{\includegraphics[height=0.55in]{primeintellect/prime_intellect_logo.png}\par\vspace{0.6em}}{}%
    \fi
    {\color{primeink}\rule{\linewidth}{4pt}}\par\vspace{0.9em}
    {\LARGE\bfseries\color{primeink}\@title\par}\vspace{0.7em}
    {\color{primeink}\rule{\linewidth}{1pt}}\par\vspace{1.2em}
    {\large\@author\par}\vspace{0.4em}
    {\normalsize\color{primemuted}\@date\par}
  \end{center}
  \vspace{1.2em}%
}

% ---- abstract (centered heading, arxiv-style narrow block) ----------------
\renewenvironment{abstract}{%
  \begin{center}{\large\bfseries Abstract}\end{center}\vspace{-0.2ex}%
  \begin{list}{}{\setlength{\leftmargin}{0.4in}\setlength{\rightmargin}{0.4in}}%
  \item\relax\noindent\ignorespaces
}{%
  \end{list}\vspace{1.0ex}%
}

% ---- citations (numbered, as in INTELLECT-3) ------------------------------
\RequirePackage[numbers,sort&compress]{natbib}
\setlength{\bibsep}{0.5ex plus 0.2ex}
\renewcommand{\bibfont}{\small}

% ---- hyperref / cleveref --------------------------------------------------
\RequirePackage{url}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=primeaccent,citecolor=primeaccent,urlcolor=primeaccent,breaklinks=true}
\RequirePackage[capitalise,noabbrev]{cleveref}

\ifpi@lineno
  \RequirePackage{lineno}
  \AtBeginDocument{\linenumbers}
\fi

\endinput
