artIndex":1038,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1078,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1083,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1104,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1109,"length":23,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1132,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1137,"length":41,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1178,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1183,"length":28,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1211,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1216,"length":45,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1261,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1266,"length":38,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1304,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1309,"length":28,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1337,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1342,"length":24,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1366,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1371,"length":39,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1410,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1415,"length":23,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1438,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1442,"length":306,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1748,"length":38,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":558206921,"textPrimary":4278854454,"textSecondary":4282013550,"invertedBackground":4279851919,"overlayBackground":3423216438},"darkThemeColorPalette":{"baseBackground":4278325532,"raisedBackground":4278854454,"additiveBackground":725979081,"textPrimary":4292931578,"textSecondary":4289513437,"invertedBackground":4286363619,"overlayBackground":3423216438},"colorSampledDescriptionBodyText":{"content":"A short video explaining the rumored recurrent depth (looped transformer) architectural design in OpenAI's new (upcoming) Astra model.\n\nIn particular, I discuss what looped transformers are and go over the related literature.\n\nUPDATE: Expanding on the video, I also put together a longer write-up on the topic: https://magazine.sebastianraschka.com...\n\nOther links and references\n\nThe Information article on OpenAI Astra:\nhttps://www.theinformation.com/articl...\n\nLooped depth sharing explainer:\nhttps://sebastianraschka.com/llm-arch...\n\nLLM Architecture Gallery:\nhttps://www.sebastianraschka.com/llm-...\n\nNanbeige4.2-3B technical report:\nhttps://arxiv.org/abs/2607.22083\n\nMixture-of-Recursions:\nhttps://arxiv.org/abs/2507.10524\n\nUniversal Transformers:\nhttps://arxiv.org/abs/1807.03819\n\nScaling up Test-Time Compute with Latent Reasoning:\nhttps://arxiv.org/abs/2502.05171\n\n00:00 OpenAI Astra and the Recurrent-Depth Rumor\n01:37 Claims About Recurrent Depth\n03:02 Nanbeige4.2-3B’s Looped Transformer\n05:21 Why Reuse the Same Layers?\n07:43 Training From Scratch vs. Retrofitting\n09:47 Why Use Two Passes?\n10:35 KV-Cache Implications\n12:00 Mixture-of-Recursions and Dynamic Depth\n16:18 Validation-Loss Comparison\n18:16 Attention and KV Caching With Dynamic Depth\n19:55 Recurrent Depth and Chain of Thought\n23:26 Recursive Self-Improvement\n24:27 Universal Transformers\n25:27 Latent Reasoning With Recurrent Depth\n27:09 Summary\n\nCorrections:\n3:09 I incorrectly said that Nanbeige was developed in India. Nanbeige4.2-3B was developed by Nanbeige LLM Lab and Boss Zhipin in China. I had confused it with Sarvam AI, which is based in India.\n\nIf you enjoyed this video, I also write about LLM research and model architectures in my Ahead of AI newsletter:\nhttps://magazine.sebastianraschka.com/","commandRuns":[{"startIndex":311,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAciEwjA0abf1Z2XAxVikKwCHZ5DL1VIlYHh_7P_iZ8pygEEXt9iGw==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRW9pNUdKbERsRllRc0IwVmJlbUIzdHxBSTVJdTVzTWZLNVZvRjA1WmNsS1l5amctdHEydmlhellqNGMtT1ZCbjkyczdzeFlueVd5bnZtMEFZM2ZUVmRZcG5tdHdRUjNtZFhQZTBXNVVXeUpqanB6TGFiYWh1dDhMOFMy\u0026q=https%3A%2F%2Fmagazine.sebastianraschka.com%2Fp%2Fgpt-6-astra-looped-transformers-and\u0026v=KT4n-z_4QJU","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRW9pNUdKbERsRllRc0IwVmJlbUIzdHxBSTVJdTVzTWZLNVZvRjA1WmNsS1l5amctdHEydmlhellqNGMtT1ZCbjkyczdzeFlueVd5bnZtMEFZM2ZUVmRZcG5tdHdRUjNtZFhQZTBXNVVXeUpqanB6TGFiYWh1dDhMOFMy\u0026q=https%3A%2F%2Fmagazine.sebastianraschka.com%2Fp%2Fgpt-6-astra-looped-transformers-and\u0026v=KT4n-z_4QJU","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":422,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAciEwjA0abf1Z2XAxVikKwCHZ5DL1VIlYHh_7P_iZ8pygEEXt9iGw==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=