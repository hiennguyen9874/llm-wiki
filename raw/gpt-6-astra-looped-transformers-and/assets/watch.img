adPolicy":[{"minReadaheadMs":1200}]}},"platypusUseEnvoyNetFetch":false,"fixLivePlaybackModelDefaultPosition":false},"webPlayerConfig":{"useCobaltTvosDash":true,"webPlayerActionsPorting":{"getSharePanelCommand":{"clickTrackingParams":"CAAQu2kiEwjPwabf1Z2XAxUPGmYEHeTWIvPKAQRe32Ib","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/share/get_web_player_share_panel"}},"webPlayerShareEntityServiceEndpoint":{"serializedShareEntity":"CgtLVDRuLXpfNFFKVQ%3D%3D"}},"subscribeCommand":{"clickTrackingParams":"CAAQu2kiEwjPwabf1Z2XAxUPGmYEHeTWIvPKAQRe32Ib","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/subscribe"}},"subscribeEndpoint":{"channelIds":["UC_CzsS7UTjcxJ-xXp1ftxtA"],"params":"EgIIBxgA"}},"unsubscribeCommand":{"clickTrackingParams":"CAAQu2kiEwjPwabf1Z2XAxUPGmYEHeTWIvPKAQRe32Ib","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UC_CzsS7UTjcxJ-xXp1ftxtA"],"params":"CgIIBxgA"}},"addToWatchLaterCommand":{"clickTrackingParams":"CAAQu2kiEwjPwabf1Z2XAxUPGmYEHeTWIvPKAQRe32Ib","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"addedVideoId":"KT4n-z_4QJU","action":"ACTION_ADD_VIDEO"}]}},"removeFromWatchLaterCommand":{"clickTrackingParams":"CAAQu2kiEwjPwabf1Z2XAxUPGmYEHeTWIvPKAQRe32Ib","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"action":"ACTION_REMOVE_VIDEO_BY_VIDEO_ID","removedVideoId":"KT4n-z_4QJU"}]}}}}},"storyboards":{"playerStoryboardSpecRenderer":{"spec":"https://i.ytimg.com/sb/KT4n-z_4QJU/storyboard3_L$L/$N.jpg?sqp=-oaymwGhAUg48quKqQOYAYgBAZUBAAAEQpgBMqABPKgBBLIBQBANDBAVHyYtDg4PEhcrLCkPDhAVHyoyKQ8RFBgmPTgtERQeKjFLRzYVHCkuOUdNPyUuNz1HUlFFM0BCQ0xERkO6AUARERUjRENDQxETFi9DQ0NDFRYpQ0NDQ0MjL0NDQ0NDQ0RDQ0NDQ0JCQ0NDQ0NCQkJDQ0NDQkJCQkNDQ0JCQkJCovOX_wMGCMmv4tQG|48#27#100#10#10#0#default#rs$AOn4CLDc2TnMxi9Yxgd5SoF-g3B3BpJ-wA|80#45#170#10#10#10000#M$M#rs$AOn4CLCkOyelR2pOyd6GUP5q3Or3x-XTqQ|160#90#170#5#5#10000#M$M#rs$AOn4CLA7o9_CgLFx9Gcja-66vPRQrTSCBw|320#180#170#3#3#10000#M$M#rs$AOn4CLC7nPlQlzwx5MZ81gL9myzoohkblA","recommendedLevel":3,"fineScrubbingRecommendedLevel":2,"highResolutionRecommendedLevel":3}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/KT4n-z_4QJU/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/KT4n-z_4QJU","width":1280,"height":720},"title":{"simpleText":"OpenAI Astra and Recurrent Depth / Looped Transformers"},"description":{"simpleText":"A short video explaining the rumored recurrent depth (looped transformer) architectural design in OpenAI's new (upcoming) Astra model.\n\nIn particular, I discuss what looped transformers are and go over the related literature.\n\nUPDATE: Expanding on the video, I also put together a longer write-up on the topic: https://magazine.sebastianraschka.com/p/gpt-6-astra-looped-transformers-and\n\nOther links and references\n\nThe Information article on OpenAI Astra:\nhttps://www.theinformation.com/articles/secret-technique-behind-openais-astra-model-sparks-security-concerns\n\nLooped depth sharing explainer:\nhttps://sebastianraschka.com/llm-architecture-gallery/looped-depth-sharing/\n\nLLM Architecture Gallery:\nhttps://www.sebastianraschka.com/llm-architecture-gallery/\n\nNanbeige4.2-3B technical report:\nhttps://arxiv.org/abs/2607.22083\n\nMixture-of-Recursions:\nhttps://arxiv.org/abs/2507.10524\n\nUniversal Transformers:\nhttps://arxiv.org/abs/1807.03819\n\nScaling up Test-Time Compute with Latent Reasoning:\nhttps://arxiv.org/abs/2502.05171\n\n00:00 OpenAI Astra and the Recurrent-Depth Rumor\n01:37 Claims About Recurrent Depth\n03:02 Nanbeige4.2-3B’s Looped Transformer\n05:21 Why Reuse the Same Layers?\n07:43 Training From Scratch vs. Retrofitting\n09:47 Why Use Two Passes?\n10:35 KV-Cache Implications\n12:00 Mixture-of-Recursions and Dynamic Depth\n16:18 Validation-Loss Comparison\n18:16 Attention and KV Caching With Dynamic Depth\n19:55 Recurrent Depth and Chain of Thought\n23:26 Recursive Self-Improvement\n24:27 Universal Transformers\n25:27 Latent Reasoning With Recurrent Depth\n27:09 Summary\n\nCorrections:\n3:09 I incorrectly said that Nanbeige was developed in India. Nanbeige4.2-3B was developed by Nanbeige LLM Lab and Boss Zhipin in China. I had confused it with Sarvam AI, which is based in India.\n\nIf you enjoyed this video, I also write about LLM research and model architectures in my Ahead of AI newsletter:\nhttps://magazine.sebastianraschka.com/"},"lengthSeconds":"1684","ownerProfileUrl":"http://www.youtube.com/@SebastianRaschka","externalChannelId":"UC_CzsS7UTjcxJ-xXp1ftxtA","isFamilySafe":true,"availableCountries":["AD","AE","AF","AG","AI","AL","AM","AO","AQ","AR","AS","AT","AU","AW","AX","AZ","BA","BB","BD","BE","BF","BG","BH","BI","BJ","BL","BM","BN","BO","BQ","BR","BS","BT","BV","BW","BY","BZ","CA","CC","CD","CF","CG","CH","CI","CK","CL","CM","CN","CO","CR","CU","CV","CW","CX","CY","CZ","DE","DJ","DK","DM","DO","DZ","EC","EE","EG","EH","ER","ES","ET","FI","FJ","FK","FM","FO","FR","GA","GB","GD","GE","GF","GG","GH","GI","GL","GM","GN","GP","GQ","GR","GS","GT","GU","GW","GY","HK","HM","HN","HR","HT","HU","ID","IE","IL","IM","IN","IO","IQ","IR","IS","IT","JE","JM","JO","JP","KE","KG","KH","KI","KM","KN","KP","KR","KW","KY","KZ","LA","LB","LC","LI","LK","LR","LS","LT","LU","LV","LY","MA","MC","MD","ME","MF","MG","MH","MK","ML","MM","MN","MO","MP","MQ","MR","MS","MT","MU","MV","MW","MX","MY","MZ","NA","NC","NE","NF","NG","NI","NL","NO","NP","NR","NU","NZ","OM","PA","PE","PF","PG","PH","PK","PL","PM","PN","PR","PS","PT","PW","PY","QA","RE","RO","RS","RU","RW","SA","SB","SC","SD","SE","SG","SH","SI","SJ","SK","SL","SM","SN","SO","SR","SS","ST","SV","SX","S