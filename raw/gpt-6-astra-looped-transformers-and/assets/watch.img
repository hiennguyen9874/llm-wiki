lette":{"baseBackground":4278325532,"raisedBackground":4278854454,"additiveBackground":725979081,"textPrimary":4292931578,"textSecondary":4289513437,"invertedBackground":4286363619,"overlayBackground":3423216438},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtLVDRuLXpfNFFKVSDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"120.955"},"label":{"simpleText":"Lượt xem"},"accessibilityText":"120.955 lượt xem","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":558206921,"textPrimary":4278854454,"textSecondary":4282013550,"invertedBackground":4279851919,"overlayBackground":3423216438},"darkThemeColorPalette":{"baseBackground":4278325532,"raisedBackground":4278854454,"additiveBackground":725979081,"textPrimary":4292931578,"textSecondary":4289513437,"invertedBackground":4286363619,"overlayBackground":3423216438},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2 thg 9"},"label":{"simpleText":"2026"},"accessibilityText":"2 thg 9, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":558206921,"textPrimary":4278854454,"textSecondary":4282013550,"invertedBackground":4279851919,"overlayBackground":3423216438},"darkThemeColorPalette":{"baseBackground":4278325532,"raisedBackground":4278854454,"additiveBackground":725979081,"textPrimary":4292931578,"textSecondary":4289513437,"invertedBackground":4286363619,"overlayBackground":3423216438},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBwQ040EGAciEwjA0abf1Z2XAxVikKwCHZ5DL1XKAQRe32Ib","commandMetadata":{"webCommandMetadata":{"url":"/@SebastianRaschka","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC_CzsS7UTjcxJ-xXp1ftxtA","canonicalBaseUrl":"/@SebastianRaschka"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/WDMhk87M1UCdfKbYeOwXaYeUg5_8d7kuMOPKVI8f2schrd1L8M8Si3POxWtbZEZSqlDjX6BQxg=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Hiện thêm"}},"simpleText":"...thêm"},"showLessText":{"simpleText":"Ẩn bớt"},"attributedDescriptionBodyText":{"content":"A short video explaining the rumored recurrent depth (looped transformer) architectural design in OpenAI's new (upcoming) Astra model.\n\nIn particular, I discuss what looped transformers are and go over the related literature.\n\nUPDATE: Expanding on the video, I also put together a longer write-up on the topic: https://magazine.sebastianraschka.com...\n\nOther links and references\n\nThe Information article on OpenAI Astra:\nhttps://www.theinformation.com/articl...\n\nLooped depth sharing explainer:\nhttps://sebastianraschka.com/llm-arch...\n\nLLM Architecture Gallery:\nhttps://www.sebastianraschka.com/llm-...\n\nNanbeige4.2-3B technical report:\nhttps://arxiv.org/abs/2607.22083\n\nMixture-of-Recursions:\nhttps://arxiv.org/abs/2507.10524\n\nUniversal Transformers:\nhttps://arxiv.org/abs/1807.03819\n\nScaling up Test-Time Compute with Latent Reasoning:\nhttps://arxiv.org/abs/2502.05171\n\n00:00 OpenAI Astra and the Recurrent-Depth Rumor\n01:37 Claims About Recurrent Depth\n03:02 Nanbeige4.2-3B’s Looped Transformer\n05:21 Why Reuse the Same Layers?\n07:43 Training From Scratch vs. Retrofitting\n09:47 Why Use Two Passes?\n10:35 KV-Cache Implications\n12:00 Mixture-of-Recursions and Dynamic Depth\n16:18 Validation-Loss Comparison\n18:16 Attention and KV Caching With Dynamic Depth\n19:55 Recurrent Depth and Chain of Thought\n23:26 Recursive Self-Improvement\n24:27 Universal Transformers\n25:27 Latent Reasoning With Recurrent Depth\n27:09 Summary\n\nCorrections:\n3:09 I incorrectly said that Nanbeige was developed in India. Nanbeige4.2-3B was developed by Nanbeige LLM Lab and Boss Zhipin in China. I had confused it with Sarvam AI, which is based in India.\n\nIf you enjoyed this video, I also write about LLM research and model architectures in my Ahead of AI newsletter:\nhttps://magazine.sebastianraschka.com/","commandRuns":[{"startIndex":311,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAciEwjA0abf1Z2XAxVikKwCHZ5DL1VIlYHh_7P_iZ8pygEEXt9iGw==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRTh4V1FlaEs0Q2tsV1BNaXBDZzdYN3xBSTVJdTV0dFk5RXVGWDU2UGdOOWJMdEFvR2REY3MtRm5MTXhMbE1CNjlIbjNDbVdFMlFzNkN6R1k1OEVUMklUVXJta1R6V3VVTXUwZGMyXzlPZ2JuLS1NRmJsTl9yOG9RTzZE\u0026q=https%3A%2F%2Fmagazine.sebastianraschka.com%2Fp%2Fgpt-6-astra-looped-transformers-and\u0026v=KT4n-z_4QJU","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRTh4V1FlaEs0Q2tsV1BNaXBDZzdYN3xBSTVJdTV0dFk5RXVGWDU2UGdOOWJMdEFvR2REY3MtRm5MTXhMbE1CNjlIbjNDbVdFMlFzNkN6R1k1OEVUMklUVXJta1R6V3VVTXUwZGMyXzlPZ2JuLS1NRmJsTl9yOG9RTzZE\u0026q=https%3A%2F%2Fmagazine.sebastianraschka.com%2Fp%2Fgpt-6-astra-looped-transformers-and\u0026v=KT4n-z_4QJU","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":422,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAciEwjA0abf1Z2XAxVikKwCHZ5DL1VIlYHh_7P_iZ8pygEEXt9iGw==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRnUydDZNYk9Pa3F0bjIyZnMyNVpkRXxBSTVJdTV2cjFVZlU0OVR1ams4QnF0QVpiVnhXUWh0TmlyMTVnZHJIR2ljMzhqb3AtYl9RZHNXTXZCVjBSd2xzbjNrTS10VmhDdXZVbGZ4MWxvRG1TbmFuanlZQll0ajc3dkE2\u0026q=https%3A%2F%2Fwww.theinformation.com%2Farticles%2Fsecret-technique-behind-openais-astra-model-sparks-security-concerns\u0026v=K