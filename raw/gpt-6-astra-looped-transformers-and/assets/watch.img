uageCode":"sn","languageName":{"simpleText":"Tiếng Shona"}},{"languageCode":"sd","languageName":{"simpleText":"Tiếng Sindhi"}},{"languageCode":"si","languageName":{"simpleText":"Tiếng Sinhala"}},{"languageCode":"sk","languageName":{"simpleText":"Tiếng Slovak"}},{"languageCode":"sl","languageName":{"simpleText":"Tiếng Slovenia"}},{"languageCode":"so","languageName":{"simpleText":"Tiếng Somali"}},{"languageCode":"su","languageName":{"simpleText":"Tiếng Sunda"}},{"languageCode":"sw","languageName":{"simpleText":"Tiếng Swahili"}},{"languageCode":"ss","languageName":{"simpleText":"Tiếng Swati"}},{"languageCode":"tg","languageName":{"simpleText":"Tiếng Tajik"}},{"languageCode":"ta","languageName":{"simpleText":"Tiếng Tamil"}},{"languageCode":"tt","languageName":{"simpleText":"Tiếng Tatar"}},{"languageCode":"es","languageName":{"simpleText":"Tiếng Tây Ban Nha"}},{"languageCode":"bo","languageName":{"simpleText":"Tiếng Tây Tạng"}},{"languageCode":"te","languageName":{"simpleText":"Tiếng Telugu"}},{"languageCode":"th","languageName":{"simpleText":"Tiếng Thái"}},{"languageCode":"tr","languageName":{"simpleText":"Tiếng Thổ Nhĩ Kỳ"}},{"languageCode":"sv","languageName":{"simpleText":"Tiếng Thụy Điển"}},{"languageCode":"ti","languageName":{"simpleText":"Tiếng Tigrinya"}},{"languageCode":"to","languageName":{"simpleText":"Tiếng Tonga"}},{"languageCode":"zh-Hans","languageName":{"simpleText":"Tiếng Trung (Giản Thể)"}},{"languageCode":"zh-Hant","languageName":{"simpleText":"Tiếng Trung (Phồn Thể)"}},{"languageCode":"ts","languageName":{"simpleText":"Tiếng Tsonga"}},{"languageCode":"tn","languageName":{"simpleText":"Tiếng Tswana"}},{"languageCode":"tum","languageName":{"simpleText":"Tiếng Tumbuka"}},{"languageCode":"tk","languageName":{"simpleText":"Tiếng Turkmen"}},{"languageCode":"uk","languageName":{"simpleText":"Tiếng Ukraina"}},{"languageCode":"ur","languageName":{"simpleText":"Tiếng Urdu"}},{"languageCode":"ug","languageName":{"simpleText":"Tiếng Uyghur"}},{"languageCode":"uz","languageName":{"simpleText":"Tiếng Uzbek"}},{"languageCode":"ve","languageName":{"simpleText":"Tiếng Venda"}},{"languageCode":"vi","languageName":{"simpleText":"Tiếng Việt"}},{"languageCode":"cy","languageName":{"simpleText":"Tiếng Wales"}},{"languageCode":"war","languageName":{"simpleText":"Tiếng Waray"}},{"languageCode":"wo","languageName":{"simpleText":"Tiếng Wolof"}},{"languageCode":"xh","languageName":{"simpleText":"Tiếng Xhosa"}},{"languageCode":"yi","languageName":{"simpleText":"Tiếng Yiddish"}},{"languageCode":"yo","languageName":{"simpleText":"Tiếng Yoruba"}},{"languageCode":"zu","languageName":{"simpleText":"Tiếng Zulu"}}],"defaultAudioTrackIndex":3}},"videoDetails":{"videoId":"KT4n-z_4QJU","title":"OpenAI Astra and Recurrent Depth / Looped Transformers","lengthSeconds":"1683","keywords":["LLMs","OpenAI","Large Language Models","Transformers","AI Research"],"channelId":"UC_CzsS7UTjcxJ-xXp1ftxtA","isOwnerViewing":false,"shortDescription":"A short video explaining the rumored recurrent depth (looped transformer) architectural design in OpenAI's new (upcoming) Astra model.\n\nIn particular, I discuss what looped transformers are and go over the related literature.\n\nUPDATE: Expanding on the video, I also put together a longer write-up on the topic: https://magazine.sebastianraschka.com/p/gpt-6-astra-looped-transformers-and\n\nOther links and references\n\nThe Information article on OpenAI Astra:\nhttps://www.theinformation.com/articles/secret-technique-behind-openais-astra-model-sparks-security-concerns\n\nLooped depth sharing explainer:\nhttps://sebastianraschka.com/llm-architecture-gallery/looped-depth-sharing/\n\nLLM Architecture Gallery:\nhttps://www.sebastianraschka.com/llm-architecture-gallery/\n\nNanbeige4.2-3B technical report:\nhttps://arxiv.org/abs/2607.22083\n\nMixture-of-Recursions:\nhttps://arxiv.org/abs/2507.10524\n\nUniversal Transformers:\nhttps://arxiv.org/abs/1807.03819\n\nScaling up Test-Time Compute with Latent Reasoning:\nhttps://arxiv.org/abs/2502.05171\n\n00:00 OpenAI Astra and the Recurrent-Depth Rumor\n01:37 Claims About Recurrent Depth\n03:02 Nanbeige4.2-3B’s Looped Transformer\n05:21 Why Reuse the Same Layers?\n07:43 Training From Scratch vs. Retrofitting\n09:47 Why Use Two Passes?\n10:35 KV-Cache Implications\n12:00 Mixture-of-Recursions and Dynamic Depth\n16:18 Validation-Loss Comparison\n18:16 Attention and KV Caching With Dynamic Depth\n19:55 Recurrent Depth and Chain of Thought\n23:26 Recursive Self-Improvement\n24:27 Universal Transformers\n25:27 Latent Reasoning With Recurrent Depth\n27:09 Summary\n\nCorrections:\n3:09 I incorrectly said that Nanbeige was developed in India. Nanbeige4.2-3B was developed by Nanbeige LLM Lab and Boss Zhipin in China. I had confused it with Sarvam AI, which is based in India.\n\nIf you enjoyed this video, I also write about LLM research and model architectures in my Ahead of AI newsletter:\nhttps://magazine.sebastianraschka.com/","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/KT4n-z_4QJU/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLDO9DFn4EcxTiB9cKmV-llVLW6QDw\u0026usqp=CBQ","width":168,"height":94},{"url":"https://i.ytimg.com/vi/KT4n-z_4QJU/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLDWjLN9VL65TQQYiWe3r7uc3YfXGQ\u0026usqp=CBQ","width":196,"height":110},{"url":"https://i.ytimg.com/vi/KT4n-z_4QJU/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLB-fNKBO2ByisK9eCbnjbkV1ex0Mg\u0026usqp=CBQ","width":246,"height":138},{"url":"https://i.ytimg.com/vi/KT4n-z_4QJU/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLAQXsIW5E7GHlL0NLpiYWUeQ6KrIg\u0026usqp=CBQ","width":336,"height":188},{"url":"https://i.ytimg.com/vi/KT4n-z_4QJU/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"120970","author":"Sebastian Raschka","isPrivate":false,"isUnplugg