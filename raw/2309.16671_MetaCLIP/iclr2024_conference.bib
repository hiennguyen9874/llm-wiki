@inproceedings{shu-etal-2017-doc,
    title = "{DOC}: Deep Open Classification of Text Documents",
    author = "Shu, Lei  and
      Xu, Hu  and
      Liu, Bing",
    booktitle = "Proceedings of the 2017 Conference on Empirical Methods in Natural Language Processing",
    month = sep,
