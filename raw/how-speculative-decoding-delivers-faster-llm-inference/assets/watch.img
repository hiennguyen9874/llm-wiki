er":{"title":{"runs":[{"text":"Giấy phép"}]},"contents":[{"runs":[{"text":"Giấy phép Creative Commons - Ghi công (cho phép tái sử dụng)","navigationEndpoint":{"clickTrackingParams":"CMkBEM2rARgBIhMI6rzyr9HvlgMVQ1F4AB3TRxcHygEEODoebQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/t/creative_commons","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/t/creative_commons"}}}]}],"trackingParams":"CMkBEM2rARgBIhMI6rzyr9HvlgMVQ1F4AB3TRxcH"}}],"collapsedItemCount":0,"trackingParams":"CMkBEM2rARgBIhMI6rzyr9HvlgMVQ1F4AB3TRxcH"}},"showMoreText":{"simpleText":"...thêm"},"showLessText":{"simpleText":"Ẩn bớt"},"trackingParams":"CMkBEM2rARgBIhMI6rzyr9HvlgMVQ1F4AB3TRxcH","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CMkBEM2rARgBIhMI6rzyr9HvlgMVQ1F4AB3TRxcHygEEODoebQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CMkBEM2rARgBIhMI6rzyr9HvlgMVQ1F4AB3TRxcHygEEODoebQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CMkBEM2rARgBIhMI6rzyr9HvlgMVQ1F4AB3TRxcHygEEODoebQ==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CMkBEM2rARgBIhMI6rzyr9HvlgMVQ1F4AB3TRxcHygEEODoebQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Before a large language model can generate a response, the raw input text must first undergo tokenization, where sentences are converted into numerical token IDs. Once the model begins processing those IDs, it encounters the primary performance limitation of modern AI infrastructure.\n\nTypically, LLMs generate text autoregressively, meaning they can only produce a single token at a time. Each individual token generation requires a full forward pass through billions or potentially trillions of parameters within the network. Because every step in this process is strictly sequential, the system cannot generate token 50 until token 49 has been completely processed. This exhaustive, one-item-at-a-time sequence represents the fundamental bottleneck in LLM inference.\n\nThis short visualization illustrates step 1 of the pipeline: converting a prompt like \"The future is open.\" into distinct numerical token IDs before the sequential autoregressive process begins.\n\nTo overcome this constraint without losing model accuracy, production environments use advanced optimization strategies like speculative decoding to validate multiple tokens simultaneously.","styleRuns":[{"startIndex":0,"length":1156,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":1156,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}]}},{"compositeVideoPrimaryInfoRenderer":{}},{"itemSectionRenderer":{"contents":[{"continuationItemRenderer":{"trigger":"CONTINUATION_TRIGGER_ON_ITEM_SHOWN","continuationEndpoint":{"clickTrackingParams":"CMcBELsvGAMiEwjqvPKv0e-WAxVDUXgAHdNHFwfKAQQ4Oh5t","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/next"}},"continuationCommand":{"token":"Eg0SCzhnSW1EbVVMX2x3GAYyJSIRIgs4Z0ltRG1VTF9sdzAAeAJCEGNvbW1lbnRzLXNlY3Rpb24%3D","request":"CONTINUATION_REQUEST_TYPE_WATCH_NEXT"}}}}],"trackingParams":"CMcBELsvGAMiEwjqvPKv0e-WAxVDUXgAHdNHFwc=","header":{"commentsHeaderRenderer":{"countText":{"runs":[{"text":"Bình luận"}]},"trackingParams":"CMgBEO6YASITCOq88q_R75YDFUNReAAd00cXBw==","screenReaderOnly":true}},"sectionIdentifier":"comment-item-section","targetId":"comments-section"}}],"trackingParams":"CMYBELovIhMI6rzyr9HvlgMVQ1F4AB3TRxcH"}},"secon