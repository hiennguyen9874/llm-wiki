utube.com/pagead/viewthroughconversion/962985656/?backend=innertube\u0026cname=1\u0026cver=2_20260911\u0026data=backend%3Dinnertube%3Bcname%3D1%3Bcver%3D2_20260911%3Bptype%3Df_view%3Btype%3Dview%3Butuid%3D7noUdfWp-ukXUlAsJnSm-Q%3Butvid%3Dr0P0zKLV4Yw\u0026foc_id=7noUdfWp-ukXUlAsJnSm-Q\u0026label=followon_view\u0026ptype=f_view\u0026random=166335358\u0026utuid=7noUdfWp-ukXUlAsJnSm-Q","elapsedMediaTimeSeconds":0},"googleRemarketingUrl":{"baseUrl":"https://www.google.com/pagead/1p-user-list/962985656/?backend=innertube\u0026cname=1\u0026cver=2_20260911\u0026data=backend%3Dinnertube%3Bcname%3D1%3Bcver%3D2_20260911%3Bptype%3Df_view%3Btype%3Dview%3Butuid%3D7noUdfWp-ukXUlAsJnSm-Q%3Butvid%3Dr0P0zKLV4Yw\u0026is_vtc=0\u0026ptype=f_view\u0026random=520704185\u0026utuid=7noUdfWp-ukXUlAsJnSm-Q","elapsedMediaTimeSeconds":0}},"videoDetails":{"videoId":"r0P0zKLV4Yw","title":"Speculative decoding vs standard LLM inference: Side-by-side speed benchmark","lengthSeconds":"92","channelId":"UC7noUdfWp-ukXUlAsJnSm-Q","isOwnerViewing":false,"shortDescription":"This side-by-side comparison demonstrates the real-world performance difference between standard large language model (LLM) inference and inference accelerated with an aggressive speculator model. Both configurations are running a Qwen3.5-9B model on a single NVIDIA H100 GPU to generate Python code based on a stream demo prompt.  \n\nOn the left, standard inference achieves a throughput of approximately 145 tokens per second. On the right, the same model running with speculative decoding reaches approximately 424 tokens per second, delivering nearly a 3x increase in token generation performance.  \n\nWhile the time to first token (TTFT) is slightly higher when initializing the speculator model, speculative decoding significantly outperforms standard sequential inference over longer text and code generation tasks. This optimized configuration utilizes a flash-based decoding method with 15 speculative tokens to maximize parallel verification passes through the main network.","isCrawlable":false,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/r0P0zKLV4Yw/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLBAJUNOVGTji5UkQwo3xOMuXlk5pw","width":168,"height":94},{"url":"https://i.ytimg.com/vi/r0P0zKLV4Yw/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLCkmCV4NU9MJoHWiN6edXqozUhcOA","width":196,"height":110},{"url":"https://i.ytimg.com/vi/r0P0zKLV4Yw/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLALkCuq3H1Kl1RXtm1LoxB5P51Uug","width":246,"height":138},{"url":"https://i.ytimg.com/vi/r0P0zKLV4Yw/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLBxn3l22m5NaTr75KoAcwdRAT1xRQ","width":336,"height":188},{"url":"https://i.ytimg.com/vi/r0P0zKLV4Yw/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"16","author":"Red Hat Developer","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false,"isTvfilmVideo":false},"playerConfig":{"granularVariableSpeedConfig":{"minimumPlaybackRate":25,"maximumPlaybackRate":200,"stepSize":5,"defaultPlaybackRateOptions":[{"label":"1,0","value":100,"isPremiumUpsell":false,"priority":5},{"label":"1,25","value":125,"isPremiumUpsell":false,"priority":2},{"label":"1,5","value":150,"isPremiumUpsell":false,"priority":3},{"label":"1,75","value":175,"isPremiumUpsell":false,"priority":0},{"label":"2,0","value":200,"isPremiumUpsell":false,"priority":4},{"label":"3,0","value":300,"isPremiumUpsell":true,"priority":1}]},"vssClientConfig":{"vssUsePostRequest":true},"audioConfig":{"loudnessDb":-9986,"perceptualLoudnessDb":-10000,"enablePerFormatLoudness":true,"trackAbsoluteLoudnessLkfs":-10000,"loudnessTargetLkfs":-14,"loudnessNormalizationConfig":{"applyStatefulNormalization":false,"preserveStatefulLoudnessTarget":true,"maxStatefulTimeThresholdSec":300,"minimumLoudnessTargetLkfs":-31}},"streamSe