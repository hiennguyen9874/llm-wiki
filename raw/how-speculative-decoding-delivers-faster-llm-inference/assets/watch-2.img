:3}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/r0P0zKLV4Yw/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/r0P0zKLV4Yw","width":1280,"height":720},"title":{"simpleText":"Speculative decoding vs standard LLM inference: Side-by-side speed benchmark"},"description":{"simpleText":"This side-by-side comparison demonstrates the real-world performance difference between standard large language model (LLM) inference and inference accelerated with an aggressive speculator model. Both configurations are running a Qwen3.5-9B model on a single NVIDIA H100 GPU to generate Python code based on a stream demo prompt.  \n\nOn the left, standard inference achieves a throughput of approximately 145 tokens per second. On the right, the same model running with speculative decoding reaches approximately 424 tokens per second, delivering nearly a 3x increase in token generation performance.  \n\nWhile the time to first token (TTFT) is slightly higher when initializing the speculator model, speculative decoding significantly outperforms standard sequential inference over longer text and code generation tasks. This optimized configuration utilizes a flash-based decoding method with 15 speculative tokens to maximize parallel verification passes through the main network."},"lengthSeconds":"92","ownerProfileUrl":"http://www.youtube.com/@RedHatDevelopers","externalChannelId":"UC7noUdfWp-ukXUlAsJnSm-Q","isFamilySafe":true,"availableCountries":["AD","AE","AF","AG","AI","AL","AM","AO","AQ","AR","AS","AT","AU","AW","AX","AZ","BA","BB","BD","BE","BF","BG","BH","BI","BJ","BL","BM","BN","BO","BQ","BR","BS","BT","BV","BW","BY","BZ","CA","CC","CD","CF","CG","CH","CI","CK","CL","CM","CN","CO","CR","CU","CV","CW","CX","CY","CZ","DE","DJ","DK","DM","DO","DZ","EC","EE","EG","EH","ER","ES","ET","FI","FJ","FK","FM","FO","FR","GA","GB","GD","GE","GF","GG","GH","GI","GL","GM","GN","GP","GQ","GR","GS",