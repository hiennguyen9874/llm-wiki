asses through the main network.","styleRuns":[{"startIndex":0,"length":982,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":982,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}]}},{"compositeVideoPrimaryInfoRenderer":{}},{"itemSectionRenderer":{"contents":[{"continuationItemRenderer":{"trigger":"CONTINUATION_TRIGGER_ON_ITEM_SHOWN","continuationEndpoint":{"clickTrackingParams":"CMkBELsvGAMiEwiJ1cqw0e-WAxXAAoMDHWiBAQfKAQSyo3TO","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/next"}},"continuationCommand":{"token":"Eg0SC3IwUDB6S0xWNFl3GAYyJSIRIgtyMFAwektMVjRZdzAAeAJCEGNvbW1lbnRzLXNlY3Rpb24%3D","request":"CONTINUATION_REQUEST_TYPE_WATCH_NEXT"}}}}],"trackingParams":"CMkBELsvGAMiEwiJ1cqw0e-WAxXAAoMDHWiBAQc=","header":{"commentsHeaderRenderer":{"countText":{"runs":[{"text":"Bình luận"}]},"trackingParams":"CMoBEO6YASITCInVyrDR75YDFcACgwMdaIEBBw==","screenReaderOnly":true}},"sectionIdentifier":"comment-item-section","targetId":"comments-section"}}],"trackingParams":"CMgBELovIhMIidXKsNHvlgMVwAKDAx1ogQEH"}},"secondaryResults":{"secondaryResults":{"results":[{"itemSectionRenderer":{"contents":[{"lockupViewModel":{"contentImage":{"thumbnailViewModel":{"image":{"sources":[{"url":"https://i.ytimg.com/vi/wVLhvXB2flE/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLAD4jr9XkOYHDCC81VvY1YfGs2xwQ","width":168,"height":94},{"url":"https://i.ytimg.com/vi/wVLhvXB2flE/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLA9t0xDdkRndRtOXmgWiCcLkS_qJQ","width":336,"height":188}]},"overlays":[{"thumbnailBottomOverlayViewModel":{"badges":[{"thumbnailBadgeViewModel":{"icon":{"sources":[{"clientResource":{"imageName":"MUSIC"}}]},"text":"1:31:51","badgeStyle":"THUMBNAIL_OVERLAY_BADGE_