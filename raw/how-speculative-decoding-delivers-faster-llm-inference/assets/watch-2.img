ewCountEntityKey":"EgtyMFAwektMVjRZdyDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"16"},"label":{"simpleText":"Lượt xem"},"accessibilityText":"16 lượt xem","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294440951,"raisedBackground":4294440951,"additiveBackground":562530183,"textPrimary":4280295456,"textSecondary":4283716692,"invertedBackground":4283716692,"overlayBackground":3424657440},"darkThemeColorPalette":{"baseBackground":4279176975,"raisedBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"12 thg 6"},"label":{"simpleText":"2026"},"accessibilityText":"12 thg 6, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294440951,"raisedBackground":4294440951,"additiveBackground":562530183,"textPrimary":4280295456,"textSecondary":4283716692,"invertedBackground":4283716692,"overlayBackground":3424657440},"darkThemeColorPalette":{"baseBackground":4279176975,"raisedBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBIQ040EGAUiEwiJ1cqw0e-WAxXAAoMDHWiBAQfKAQSyo3TO","commandMetadata":{"webCommandMetadata":{"url":"/@RedHatDevelopers","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC7noUdfWp-ukXUlAsJnSm-Q","canonicalBaseUrl":"/@RedHatDevelopers"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/A3R4flViyDbjXMRSic4vnIAub2S6HfFUYSJUKKxLbdv6PbrZnRFINGaSsuaxgTN4YPLpRYlebQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Hiện thêm"}},"simpleText":"...thêm"},"showLessText":{"simpleText":"Ẩn bớt"},"attributedDescriptionBodyText":{"content":"This side-by-side comparison demonstrates the real-world performance difference between standard large language model (LLM) inference and inference accelerated with an aggressive speculator model. Both configurations are running a Qwen3.5-9B model on a single NVIDIA H100 GPU to generate Python code based on a stream demo prompt.  \n\nOn the left, standard inference achieves a throughput of approximately 145 tokens per second. On the right, the same model running with speculative decoding reaches approximately 424 tokens per second, delivering nearly a 3x increase in token generation performance.  \n\nWhile the time to first token (TTFT) is slightly higher when initializing the speculator model, speculative decoding significantly outperforms standard sequential inference over longer text and code generation tasks. This optimized configuration utilizes a flash-based decoding method with 15 speculative tokens to maximize parallel verification passes through the main network.","styleRuns":[{"startIndex":0,"length":982,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":982,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294440951,"raisedBackground":4294440951,"additiveBackground":562530183,"textPrimary":4280295456,"textSecondary":4283716692,"invertedBackground":4283716692,"overlayBackground":3424657440},"darkThemeColorPalette":{"baseBackground":4279176975,"raisedBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"colorSampledDescriptionBodyText":{"content":"This side-by-side comparison demonstrates the real-world performance difference between standard large language model (LLM) inference and inference accelerated with an aggressive speculator model. Both configurations are running a Qwen3.5-9B model on a single NVIDIA H100 GPU to generate Python code based on a stream demo prompt.  \n\nOn the left, standard inference achieves a throughput of approximately 145 tokens per second. On the right, the same model running with speculative decoding reaches approximately 424 tokens per second, delivering nearly a 3x increase in token generation performance.  \n\nWhile the time to first token (TTFT) is slightly higher when initializing the speculator model, speculative decoding significantly outperforms standard sequential inference over longer text and code generation tasks. This optimized configuration utilizes a flash-based decoding method with 15 speculative tokens to maximize parallel verification passes through the main network.","styleRuns":[{"startIndex":0,"length":982,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4293783021},{"key":"USER_INTERFACE_THEME_LIGHT","value":4280295456}]}},"fontFamilyName":"Roboto"}]},"enableColorSampledDescriptionBodyText":true}},{"videoDescriptionInfocardsSectionRenderer":{"sectionTitle":{"simpleText":"Red Hat Developer"},"creatorVideosButton":{"buttonRenderer":{"style":"STYLE_INACTIVE_OUTLINE","size":"SIZE_DEFAULT","isDisabled":false,"text":{"simpleText":"Video"},"icon":{"iconType":"MY_VIDEOS"},"trackingParams":"CBcQ8FsiEwiJ1cqw0e-WAxXAAoMDHWiBAQc=","command":{"clickTrackingParams":"CBcQ8FsiEwiJ1cqw0e-WAxXAAoMDHWiBAQfKAQSyo3TO","commandMetadata":{"webCommandMetadata":{"url":"/channel/UC7noUdfWp-ukXUlAsJnSm-Q/videos","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"