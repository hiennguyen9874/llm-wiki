@article{10.1162/neco_a_01089,
    author = {Takase, Tomoumi and Oyama, Satoshi and Kurihara, Masahito},
    title = {Why Does Large Batch Training Result in Poor Generalization? A Comprehensive Explanation and a Better Strategy from the Viewpoint of Stochastic Optimization},
    journal = {Neural Computation},
    volume = {30},
    number = {7},
    pages = {2005-2023},
    year = {2018},
    month = {07},
    abstract = {We present a comprehensive framework of search methods, such as simulated annealing and batch training, for solving nonconvex optimization problems. These methods search a wider range by gradually decreasing the randomness added to the standard gradient descent method. The formulation that we define on the basis of this framework can be directly applied to neural network training. This produces an effective approach that gradually increases batch size during training. We also explain why large batch training degrades generalization performance, which previous studies have not clarified.},
    issn = {0899-7667},
    doi = {10.1162/neco_a_01089},
    url = {https://doi.org/10.1162/neco_a_01089},
